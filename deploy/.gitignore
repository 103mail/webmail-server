# Generated by setup.sh, and per-machine.
#
# The certificates and the federation keypairs belong to this machine. The seed
# for 103mail.com is a dump of whatever local database you had, and the data
# directories hold attachment bytes.
#
# domain/*/federation.json is checked in: it names key files, it does not hold
# key material.
certs/
keys/
seed/*.sql
data/
# The clock offset the end-to-end suite moves forward.
clock/

# A Domain's federation config as an end-to-end story changed it (an
# allowlist, a smaller attachment cap, a rotated key), mounted through
# FEDERATION_CONFIG_<DOMAIN>. The harness removes it after the story.
domain/*/federation.e2e.json
